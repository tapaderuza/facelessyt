# YouTube Data API v3 key (gratis, 10.000 unidades/dia)
# https://console.cloud.google.com/ -> nuevo proyecto -> APIs -> YouTube Data API v3 -> Credenciales -> Clave de API
#
# OJO: la clave va en .env (ignorado por git), NUNCA en este fichero.
YOUTUBE_API_KEY=

# ID de tu canal (empieza por UC...). Se rellena cuando el canal exista.
MY_CHANNEL_ID=

# --- Render (solo dentro de la imagen facelessyt-video) ---
# Loop de musica de fondo (mp3/wav, sin copyright). Se mezcla ~17 dB bajo la voz. Generar el propio: tools/make_music_loop.py
MUSIC_PATH=
# Ritmo de Piper: <1 acelera. Medido: 0.85 ~ 185-200 palabras/min.
PIPER_LENGTH_SCALE=0.85
PIPER_SENTENCE_SILENCE=0.1
# Voz de pago, opcional. Si hay clave, `render --engine auto` la usa.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
