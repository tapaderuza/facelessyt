# Imagen para generar el video: ffmpeg + TTS local (Piper) + fuentes monoespaciadas.
# Separada de la imagen del CLI porque pesa mucho mas y no hace falta para minar.
FROM python:3.12-slim

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        ffmpeg \
        fonts-dejavu-core \
        curl \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir pillow piper-tts PyYAML

# Voz de Piper: en-US, calidad media. ~60 MB, se cachea en su propia capa.
RUN mkdir -p /voices && \
    curl -sSL -o /voices/en_US-lessac-medium.onnx \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx && \
    curl -sSL -o /voices/en_US-lessac-medium.onnx.json \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx.json

ENV PIPER_VOICE=/voices/en_US-lessac-medium.onnx
ENV FACELESSYT_ROOT=/app

COPY src/ ./src/
ENV PYTHONPATH=/app/src

ENTRYPOINT ["python", "-m", "facelessyt.video"]
